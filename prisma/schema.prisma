generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum BookingSource {
  SITE
  BOT
}

model Service {
  id              String    @id @default(cuid())
  nameUz          String
  nameRu          String
  nameEn          String
  descriptionUz   String
  descriptionRu   String
  descriptionEn   String
  durationMinutes Int
  price           Int
  imageUrl        String?
  category        String
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bookings        Booking[]
}

model Master {
  id               String    @id @default(cuid())
  name             String
  photoUrl         String?
  specializationUz String
  specializationRu String
  specializationEn String
  bioUz            String
  bioRu            String
  bioEn            String
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  bookings         Booking[]
}

model Booking {
  id               String        @id @default(cuid())
  clientName       String
  clientPhone      String
  clientTelegramId String?
  serviceId        String
  masterId         String
  startsAt         DateTime
  endsAt           DateTime
  status           BookingStatus @default(PENDING)
  source           BookingSource
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  service          Service       @relation(fields: [serviceId], references: [id])
  master           Master        @relation(fields: [masterId], references: [id])

  @@index([masterId, startsAt, endsAt])
  @@index([status])
  @@index([startsAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
