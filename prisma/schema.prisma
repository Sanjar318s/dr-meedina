generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum BookingSource {
  SITE
  BOT
}

model Service {
  id              String    @id @default(cuid())
  nameUz          String
  nameRu          String
  nameEn          String
  descriptionUz   String
  descriptionRu   String
  descriptionEn   String
  durationMinutes Int
  price           Int
  imageUrl        String?
  gallery         String? // JSON array of image URLs
  videoUrl        String?
  category        String
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bookings        Booking[]
}

model Master {
  id               String    @id @default(cuid())
  name             String
  photoUrl         String?
  specializationUz String
  specializationRu String
  specializationEn String
  bioUz            String
  bioRu            String
  bioEn            String
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  bookings         Booking[]
}

model Booking {
  id               String        @id @default(cuid())
  clientName       String
  clientPhone      String
  clientTelegramId String?
  serviceId        String
  masterId         String
  startsAt         DateTime
  endsAt           DateTime
  status           BookingStatus @default(PENDING)
  source           BookingSource
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  service          Service       @relation(fields: [serviceId], references: [id])
  master           Master        @relation(fields: [masterId], references: [id])

  @@index([masterId, startsAt, endsAt])
  @@index([status])
  @@index([startsAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model SiteSettings {
  id             String   @id @default("default")
  brand          String   @default("Dr.Meedina")
  doctorName     String   @default("Мадина")
  addressUz      String   @default("Toshkent")
  addressRu      String   @default("Ташкент")
  addressEn      String   @default("Tashkent")
  phone          String   @default("+998 90")
  phoneNoteUz    String   @default("To‘liq raqam — Telegram yoki Instagram orqali")
  phoneNoteRu    String   @default("Полный номер — в Telegram или Instagram")
  phoneNoteEn    String   @default("Full number via Telegram or Instagram")
  lat            Float    @default(41.33)
  lng            Float    @default(69.28)
  instagram      String   @default("https://www.instagram.com/dr.meedina/")
  telegram       String   @default("https://t.me/drmeedina")
  telegramBot    String   @default("https://t.me/Dr_Meedinabot?start=book")
  taglineUz      String   @default("Toza teri — sizning ishonchingiz")
  taglineRu      String   @default("Чистая кожа — твоя уверенность")
  taglineEn      String   @default("Clear skin is your confidence")
  welcomeImageUrl String?
  updatedAt      DateTime @updatedAt
}

model BotUser {
  id             String        @id @default(cuid())
  telegramId     String        @unique
  username       String?
  firstName      String?
  lastName       String?
  lang           String        @default("ru")
  subscribedNews Boolean       @default(true)
  lastSeenAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  activities     BotActivity[]
}

model NewsPost {
  id        String   @id @default(cuid())
  text      String
  imageUrl  String?
  createdBy String?
  broadcast Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BotActivity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  meta      String? // JSON
  createdAt DateTime @default(now())
  user      BotUser  @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([createdAt])
}
